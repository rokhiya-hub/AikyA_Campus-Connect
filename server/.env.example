# Supply your own MongoDB URI. Leave blank until configured.
NODE_ENV=development
MONGODB_URI=
PORT=5000
# Optional. Enable only after provisioning tracking indexes and a replica-set MongoDB.
BUS_TRACKING_ENABLED=false
# Comma-separated browser origins.
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Required for authentication. Production requires at least 32 bytes.
JWT_SECRET=
JWT_EXPIRES_IN=7d
ADMIN_USERNAME=
# Production requires an admin password of 12-72 bytes.
ADMIN_PASSWORD=

# Optional OpenAI-compatible provider configuration. Obtain these from your provider.
# All three values are required for optional external AI; no provider defaults.
# Local campus record answers work without external AI configuration.
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
# HTTPS required except loopback HTTP in development/test. Never use VITE_* keys.
AI_TIMEOUT_MS=8000
AI_MAX_TOKENS=256

# Optional Web Push. In-app notifications do not require these values.
# Provision additive notification indexes before starting the push worker.
WEB_PUSH_ENABLED=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Your actual operational mailto: or https: contact, never a fabricated value.
VAPID_SUBJECT=
