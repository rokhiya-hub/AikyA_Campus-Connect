{
  "name": "campusx-server",
  "version": "1.0.0",
  "description": "CampusX backend - AI-powered smart campus assistant",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed": "node src/seed/seed.js",
    "check": "node scripts/check.js",
    "test": "node --test",
    "migrate:buildings": "node scripts/migrate-building-links.js",
    "migrate:shops": "node scripts/migrate-shops.js",
    "tracking:indexes": "node scripts/tracking-indexes.js",
    "chat:indexes": "node scripts/chat-log-indexes.js",
    "notifications:indexes": "node scripts/notification-indexes.js",
    "notifications:worker": "node scripts/notification-worker.js",
    "test:notifications:local": "node integration-tests/notifications.local.cjs",
    "test:tracking:mongo": "node integration-tests/bus-tracking.mongo.cjs",
    "test:tracking:local": "powershell -NoProfile -File scripts/run-tracking-mongo-test.ps1"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.6.0",
    "openai": "^7.10.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10"
  }
}
