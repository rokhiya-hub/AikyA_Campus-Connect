# Public frontend configuration; never put credentials in VITE_* variables.
# Include the /api suffix. Restart Vite after changing this value.
# Local Vite proxies /api to the backend on 127.0.0.1:5000.
# For separate production hosting, use your actual HTTPS API URL ending in /api.
VITE_API_URL=/api
# DEV server only; production bundles exclude the simulator regardless of this value.
VITE_BUS_TRACKING_SIMULATION=false
